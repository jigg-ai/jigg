---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { FOUNDER } from '../lib/site';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content entry: pages/about.md');
const { Content } = await render(entry);
const firstName = FOUNDER.name.split(' ')[0];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="container container--prose about">
    <h1>About Jigg.AI</h1>
    <div class="prose stack">
      <Content />
    </div>

    {/* The one place the current lead is named (CONTEXT §4). It reads from
        lib/site.ts, the single source for person-specific facts; every other studio
        page makes the role promise instead. */}
    <section class="founder" id="lead" aria-labelledby="lead-title">
      <h2 id="lead-title">Who leads Jigg.AI</h2>
      <p class="name">{FOUNDER.name} <span class="mono">{FOUNDER.title}</span></p>
      <p>
        {FOUNDER.credential} As engineering lead, {firstName} owns each client engagement from
        the first conversation and answers for what's delivered.
        {FOUNDER.linkedin && (
          <>
            {' '}
            <a href={FOUNDER.linkedin} rel="me noopener">LinkedIn</a> has the full history.
          </>
        )}
      </p>
      <p class="cta"><a class="btn btn--primary" href="/contact">Discuss a project</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .about { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .about h1 { font-size: var(--step-h1); font-weight: 460; }
  .about .prose { margin-top: 1.5rem; }
  /* Content from <Content /> isn't scoped to this component, so reach it with
     :global. Give the opening paragraph the larger "lead" treatment that the
     old inline `class="lead"` used to carry. */
  .about :global(.prose > p:first-of-type) {
    font-size: 1.2rem;
    color: var(--ink-muted);
  }
  .founder {
    border-top: 1px solid var(--border);
    margin-top: 2.5rem;
    padding-top: 2rem;
    scroll-margin-top: 5rem;
  }
  .founder > * + * { margin-top: 0.8rem; }
  .name { font-family: var(--font-serif); font-size: 1.25rem; }
  .name .mono { margin-left: 0.5rem; }
  .cta { margin-top: 1.4rem; }
</style>
