---
/*
 * MatSignal PRD-003 founder-review prototype only.
 * Fictional fixtures, local-only demo watchlist, no network calls or real accounts.
 * Do not promote as a live competition tracker or merge without founder review.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="description" content="MatSignal preview: explore a free, simple BJJ athlete search and team-tracking experience. Fictional demo records only." />
    <meta name="theme-color" content="#101b1e" />
    <title>MatSignal — Find your people. Follow the mat. (Demo)</title>
  </head>
  <body>
    <a class="skip" href="#workspace">Skip to search</a>
    <div class="shell">
      <header class="topbar">
        <div class="brand">
          <span class="mark" aria-hidden="true"><i></i><i></i><b></b></span>
          <span>mat<span class="brand-accent">signal</span><sup>demo</sup></span>
        </div>
        <div class="top-actions">
          <span class="status"><span class="dot"></span> Concept preview</span>
          <a href="https://jigg.ai/" class="studio" rel="noopener noreferrer">by Jigg.AI ↗</a>
        </div>
      </header>

      <main>
        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span> BJJ COMPETITION TRACKING, SIMPLIFIED</p>
            <h1>Find your people.<br /><em>Follow the mat.</em></h1>
            <p class="hero-lead">Search athletes. Build your own squad. See who's competing and when—all in one place.</p>
            <div class="hero-points">
              <span>Free athlete search</span>
              <span>No gym roster required</span>
              <span>One team view</span>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-orbit orbit-one"></div>
            <div class="art-orbit orbit-two"></div>
            <div class="art-orbit orbit-three"></div>
            <div class="art-center"><span>MS</span></div>
            <span class="art-pin pin-one"></span>
            <span class="art-pin pin-two"></span>
            <span class="art-pin pin-three"></span>
            <span class="art-caption">YOUR TEAM · ONE SIGNAL</span>
          </div>
        </section>

        <div class="notice">
          <strong>Interactive product demo</strong>
          <span>Every athlete, event, and match below is fictional. No external competition sources or user accounts are connected. Selections are saved only in this browser.</span>
        </div>

        <section class="workspace" id="workspace" aria-label="Athlete search and tracking demo">
          <div class="workspace-header">
            <div>
              <p class="section-label">01 / DISCOVER</p>
              <h2>Start with an athlete.</h2>
            </div>
            <p>Search is always free. Pick the people you actually want to follow.</p>
          </div>
          <div class="workspace-grid">
            <section class="panel search-panel" aria-label="Search demo athletes">
              <label for="athlete-search" class="input-label">Search competitors</label>
              <div class="search-wrap">
                <svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
                <input id="athlete-search" type="search" autocomplete="off" placeholder="Try “Demo Athlete 01” or “Example Alliance”" />
              </div>
              <div class="search-meta">
                <label for="affiliation-filter">Affiliation</label>
                <select id="affiliation-filter">
                  <option value="all">All affiliations</option>
                  <option value="Example Alliance">Example Alliance</option>
                  <option value="Sample Jiu-Jitsu">Sample Jiu-Jitsu</option>
                </select>
                <span class="demo-tag">SAMPLE RECORDS</span>
              </div>
              <div id="search-results" class="results"></div>
              <p class="panel-footnote">Real MatSignal will resolve source-specific athlete identities and show official links. This demo does not search the internet.</p>
            </section>

            <aside class="panel squad-panel" aria-label="My selected athletes">
              <div class="squad-head">
                <div>
                  <p class="section-label">02 / YOUR SQUAD</p>
                  <h3>My tracking group <span id="squad-count" class="count">0</span></h3>
                </div>
                <button id="clear-squad" class="text-btn" type="button" disabled>Clear all</button>
              </div>
              <div id="squad-list" class="squad-list"></div>
              <div class="squad-cta">
                <div class="mini-icon" aria-hidden="true">✦</div>
                <div><strong>Saving your group will be free.</strong><p>Production accounts are not built yet. In this preview, your sample selection stays only on this device.</p></div>
              </div>
            </aside>
          </div>
        </section>

        <section class="schedule" aria-labelledby="schedule-title">
          <div class="workspace-header schedule-head">
            <div>
              <p class="section-label">03 / COMPETITION DAY</p>
              <h2 id="schedule-title">One place for every match.</h2>
            </div>
            <p>Your selected athletes appear in chronological order when a source publishes a usable match time.</p>
          </div>
          <div class="schedule-board">
            <div class="schedule-toolbar">
              <div class="toolbar-title"><span class="live-emblem" aria-hidden="true"></span> YOUR SQUAD'S MATCH QUEUE</div>
              <span class="example-flag">ILLUSTRATIVE SCHEDULE — NOT LIVE</span>
            </div>
            <div class="schedule-columns" aria-hidden="true"><span>ATHLETE & EVENT</span><span>MAT</span><span>START / STATUS</span></div>
            <div id="match-queue" class="queue"></div>
          </div>
          {/* The one live region. Changes are announced here, once, in words; the
              lists above are re-rendered silently. */}
          <p id="demo-status" class="sr-only" role="status"></p>
        </section>

        <section class="principle">
          <div><p class="section-label">THE IDEA</p><h2>No more switching between five tournament tabs.</h2></div>
          <p>MatSignal is being built as a free utility for competitors, coaches, and teammates. The next technical milestone is trustworthy discovery from publicly published competition records—without pretending a demo schedule is a live feed.</p>
        </section>
      </main>

      <footer class="footer">
        <span class="footer-brand">mat<span>signal</span></span>
        <span>Concept preview · Fictional records · No account or payment</span>
        <a href="https://jigg.ai/" rel="noopener noreferrer">A Jigg.AI experiment ↗</a>
      </footer>
    </div>
    <script>
      // Wires the demo model to the page. Every record is a fictional fixture and
      // nothing here makes a network request. Search, selection restore and queue
      // order live in src/lib/matsignal/model.ts, where `npm test` covers them.
      import { demoData } from '../../lib/matsignal/fixtures.ts';
      import {
        buildQueue,
        formatEventDate,
        hiddenByAge,
        restoreSelection,
        searchAthletes,
        timeKindLabel,
        timeLabel,
        trackedIdentities,
      } from '../../lib/matsignal/model.ts';

      const searchField = document.getElementById('athlete-search') as HTMLInputElement;
      const affiliationFilter = document.getElementById('affiliation-filter') as HTMLSelectElement;
      const resultList = document.getElementById('search-results')!;
      const squadList = document.getElementById('squad-list')!;
      const squadCount = document.getElementById('squad-count')!;
      const clearButton = document.getElementById('clear-squad') as HTMLButtonElement;
      const matchQueue = document.getElementById('match-queue')!;
      const statusLine = document.getElementById('demo-status')!;
      const storageKey = 'matsignal-demo-selected-athletes-v1';

      // Screen-reader feedback goes through the single status line, in words, once
      // per change. The lists themselves are re-rendered without announcing.
      const announce = (message: string) => { statusLine.textContent = message; };
      const groupSize = () => `${selected.size} ${selected.size === 1 ? 'athlete' : 'athletes'} in your group.`;
      let searchAnnounceTimer: ReturnType<typeof setTimeout> | undefined;

      // Blocked or invalid storage must not prevent using the preview.
      const readStored = () => {
        try {
          return localStorage.getItem(storageKey);
        } catch {
          return null;
        }
      };
      const selected = new Set(restoreSelection(readStored(), demoData.athletes));

      function node(tag: string, className?: string, value?: string) {
        const e = document.createElement(tag);
        if (className) e.className = className;
        if (value !== undefined) e.textContent = value;
        return e;
      }
      function persistSelection() {
        try { localStorage.setItem(storageKey, JSON.stringify([...selected])); } catch { /* optional local-only demo state */ }
      }
      // Re-rendering replaces the button that was just pressed, which used to drop
      // keyboard focus to <body>. So every toggle says where focus goes next: back
      // to the same athlete's Track button in the results, or, from the squad list,
      // to the neighbouring Remove button (the search box once the squad is empty).
      function toggleAthlete(id: string, from: 'results' | 'squad') {
        const squadIndex = demoData.athletes.filter((a) => selected.has(a.id)).findIndex((a) => a.id === id);
        const name = demoData.athletes.find((a) => a.id === id)?.displayName ?? '';
        const adding = !selected.has(id);
        if (adding) selected.add(id);
        else selected.delete(id);
        persistSelection();
        render();
        if (from === 'results') {
          resultList.querySelector<HTMLButtonElement>(`button[data-athlete-id="${id}"]`)?.focus();
        } else {
          const removes = squadList.querySelectorAll<HTMLButtonElement>('button.remove-btn');
          (removes[Math.min(squadIndex, removes.length - 1)] ?? searchField).focus();
        }
        announce(`${adding ? 'Tracking' : 'Stopped tracking'} ${name}. ${groupSize()}`);
      }
      function renderResults() {
        resultList.replaceChildren();
        const matches = searchAthletes(demoData.athletes, searchField.value, affiliationFilter.value);
        if (!matches.length) {
          const empty = node('div', 'empty-state');
          empty.append(node('strong', '', 'No sample matches'), node('p', '', 'This preview only contains four fictional athletes. A real search index has not been connected.'));
          resultList.append(empty);
          return;
        }
        for (const athlete of matches) {
          const item = node('div', 'result-row');
          const avatar = node('span', 'avatar', athlete.id.slice(-2));
          avatar.setAttribute('aria-hidden', 'true');
          const info = node('div', 'athlete-info');
          // One entry per platform identity; an unconfirmed same-name record says so.
          const sources = athlete.identities
            .map((i) => (i.match === 'candidate' ? `${i.source} (unconfirmed)` : i.source))
            .join(' · ');
          info.append(
            node('strong', '', athlete.displayName),
            node('span', 'affiliation', `${athlete.affiliationHint} · ${athlete.academyHint}`),
            node('small', '', `${sources} · synthetic identity`),
          );
          // The name says what pressing does next, and contains the visible text
          // ("Track", "tracking") for voice control. No aria-pressed: a pressed
          // state on top of a changing name read as "Remove …, pressed".
          const on = selected.has(athlete.id);
          const btn = node('button', 'track-btn' + (on ? ' tracked' : ''), on ? '✓ Tracking' : '+ Track') as HTMLButtonElement;
          btn.type = 'button';
          btn.dataset.athleteId = athlete.id;
          btn.setAttribute('aria-label', (on ? 'Stop tracking ' : 'Track ') + athlete.displayName);
          btn.addEventListener('click', () => toggleAthlete(athlete.id, 'results'));
          item.append(avatar, info, btn);
          resultList.append(item);
        }
      }
      function renderSquad() {
        squadList.replaceChildren();
        squadCount.textContent = String(selected.size);
        clearButton.disabled = selected.size === 0;
        if (!selected.size) {
          const empty = node('div', 'empty-squad');
          empty.append(node('span', 'empty-graphic', '+'), node('strong', '', 'Your squad starts here.'), node('p', '', 'Tap “+ Track” next to an athlete. They will appear here, and their sample matches will appear below.'));
          squadList.append(empty);
          return;
        }
        for (const athlete of demoData.athletes.filter((a) => selected.has(a.id))) {
          const row = node('div', 'squad-athlete');
          const info = node('div', 'squad-athlete-info');
          info.append(node('strong', '', athlete.displayName), node('span', '', athlete.affiliationHint ?? ''));
          const remove = node('button', 'remove-btn', '×') as HTMLButtonElement;
          remove.type = 'button';
          remove.setAttribute('aria-label', 'Remove ' + athlete.displayName);
          remove.addEventListener('click', () => toggleAthlete(athlete.id, 'squad'));
          row.append(info, remove);
          squadList.append(row);
        }
      }
      // An entry the age rule hides is announced as hidden, never left to look like
      // "no entry": an empty schedule doesn't prove there is none (HANDOFF §1).
      const hiddenNote = (hidden: number) =>
        node('p', 'queue-note', `${hidden} ${hidden === 1 ? 'entry is' : 'entries are'} hidden: MatSignal shows only divisions confirmed as adult.`);
      function renderQueue() {
        matchQueue.replaceChildren();
        const tracked = trackedIdentities(demoData.athletes, selected);
        const entries = buildQueue(demoData, tracked);
        const hidden = hiddenByAge(demoData, tracked);
        if (!entries.length) {
          const empty = node('div', 'empty-queue');
          empty.append(node('strong', '', 'No tracked matches yet.'), node('p', '', 'Select a sample athlete above to see their upcoming match queue.'));
          matchQueue.append(empty);
          if (hidden) matchQueue.append(hiddenNote(hidden));
          return;
        }
        for (const { athlete, event, match } of entries) {
          const row = node('div', 'queue-row');
          const fighter = node('div', 'queue-fighter');
          fighter.append(
            node('strong', '', athlete.displayName),
            node('span', '', `${event.name} · ${formatEventDate(event.date)}`),
            node('small', '', `${event.source} · vs ${match?.opponentLabel ?? 'TBD'}`),
          );
          const mat = node('span', 'mat-pill', match?.mat ?? 'TBD');
          const time = node('div', 'queue-time');
          time.append(node('strong', '', timeLabel(match)), node('span', '', `${timeKindLabel(match)} · Demo`));
          row.append(fighter, mat, time);
          matchQueue.append(row);
        }
        if (hidden) matchQueue.append(hiddenNote(hidden));
      }
      function render() { renderResults(); renderSquad(); renderQueue(); }
      // Results update on every keystroke, but the count is announced only once
      // typing pauses, instead of the whole list being read out per character.
      function onSearchChange() {
        renderResults();
        clearTimeout(searchAnnounceTimer);
        searchAnnounceTimer = setTimeout(() => {
          const n = searchAthletes(demoData.athletes, searchField.value, affiliationFilter.value).length;
          announce(n ? `${n} sample ${n === 1 ? 'athlete' : 'athletes'} found.` : 'No sample athletes found.');
        }, 600);
      }
      searchField.addEventListener('input', onSearchChange);
      affiliationFilter.addEventListener('change', onSearchChange);
      // Clear all disables itself, so focus moves to the search box.
      clearButton.addEventListener('click', () => {
        selected.clear();
        persistSelection();
        render();
        searchField.focus();
        announce('Cleared your group.');
      });
      render();
    </script>
  </body>
</html>

<style is:global>
  /* Global, not scoped. Astro scopes a component's styles by tagging every element
     in the markup with a data-astro-cid attribute and requiring it in each selector,
     but the rows the script builds with createElement never get that attribute, so
     with scoped styles the search results, squad and match queue rendered unstyled.
     This page loads no shared layout or site stylesheet, so global here still means
     "this page only": the bundle ships with /matsignal/ and nothing else. */
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:#101a1d;color:#f4f8f4;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;line-height:1.5}
  button,input,select{font:inherit}
  button{cursor:pointer}
  button:disabled{cursor:not-allowed;opacity:.45}
  a{color:inherit}
  :focus-visible{outline:3px solid #d4f27a;outline-offset:3px}
  .skip{position:absolute;top:-5rem;left:1rem;z-index:20;background:#d4f27a;color:#131c19;padding:.6rem 1rem}
  .skip:focus{top:1rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .shell{max-width:1340px;margin:auto;padding:0 clamp(20px,4.5vw,72px)}
  .topbar{min-height:91px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #2b3b3d;gap:1rem}
  .brand,.footer-brand{font-weight:790;letter-spacing:-.07em;font-size:1.85rem;display:flex;align-items:center;gap:13px}
  .brand-accent,.footer-brand span{color:#d3f17b}
  .brand sup{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:#96a8a0;align-self:flex-start;margin:9px 0 0 -6px}
  .mark{position:relative;width:28px;height:28px;border:2px solid #d3f17b;border-radius:100%;display:inline-flex;align-items:center;justify-content:center}
  .mark i{display:block;border:1px solid #d3f17b;border-radius:50%;position:absolute;inset:5px}
  .mark i:nth-child(2){inset:10px;background:#d3f17b}
  .mark b{width:15px;height:2px;background:#d3f17b;position:absolute;right:-7px;top:12px;transform:rotate(-35deg)}
  .top-actions{display:flex;align-items:center;gap:26px;font-size:.76rem;color:#a1b3ab}
  .status{display:flex;align-items:center;gap:8px}
  /* Hollow, unlit rings: a filled glowing dot reads as "online / live", which
     nothing on this page is. */
  .dot,.live-emblem{width:8px;height:8px;border-radius:50%;border:2px solid #d3f17b;display:inline-block}
  .studio{text-decoration:none;border-bottom:1px solid #435450;padding-bottom:2px}
  .studio:hover{color:#d3f17b}
  .hero{padding:94px 0 82px;display:grid;grid-template-columns:1.3fr .7fr;align-items:center;gap:20px;min-height:420px}
  .eyebrow,.section-label{color:#a5b8ad;font-size:.71rem;letter-spacing:.19em;font-weight:770}
  .eyebrow{display:flex;align-items:center;gap:12px}
  .eyebrow-line{display:block;width:23px;height:2px;background:#d3f17b}
  h1,h2,h3,p{margin:0}
  h1{font-size:clamp(3.1rem,6vw,6.2rem);line-height:1.06;letter-spacing:-.07em;margin:20px 0 25px;font-weight:750}
  h1 em{font-style:normal;color:#d3f17b}
  .hero-lead{max-width:540px;color:#acbdb6;font-size:clamp(1.05rem,1.6vw,1.24rem)}
  .hero-points{display:flex;gap:12px;flex-wrap:wrap;margin-top:29px}
  .hero-points span{font-size:.73rem;color:#c5d3c9;border:1px solid #344547;border-radius:30px;padding:7px 12px}
  .hero-art{position:relative;width:280px;height:280px;margin:auto}
  .art-orbit{border:1px solid #39504e;border-radius:50%;position:absolute;inset:0}
  .orbit-two{inset:45px;border-color:#5b765b}
  .orbit-three{inset:95px;border-color:#d3f17b}
  .art-center{position:absolute;inset:112px;border-radius:50%;background:#d3f17b;display:grid;place-items:center;color:#101a1d;font-size:.95rem;font-weight:800}
  .art-pin{position:absolute;width:12px;height:12px;border:2px solid #d3f17b;background:#111d20;border-radius:50%}
  .pin-one{top:34px;left:36px}.pin-two{top:105px;right:-5px}.pin-three{bottom:40px;left:22px}
  .art-caption{position:absolute;bottom:-15px;left:25px;right:25px;text-align:center;letter-spacing:.17em;font-size:.59rem;color:#8fa49b}
  .notice{display:flex;gap:20px;align-items:baseline;border:1px solid #47614b;background:#1d3028;border-radius:10px;padding:16px 19px;margin-bottom:78px}
  .notice strong{color:#d3f17b;font-size:.83rem;white-space:nowrap}
  .notice span{font-size:.81rem;color:#c0d2c6}
  .workspace-header{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:27px}
  .workspace-header h2,.principle h2{font-size:clamp(1.7rem,2.7vw,2.45rem);line-height:1.16;letter-spacing:-.04em;margin-top:10px}
  .workspace-header>p{max-width:360px;color:#a9bab2;font-size:.87rem}
  .workspace-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(270px,1fr);gap:18px}
  .panel{background:#19262a;border:1px solid #334348;border-radius:15px;padding:25px;min-width:0}
  .input-label{font-size:.78rem;font-weight:720;color:#d3dfd6;display:block;margin-bottom:10px}
  .search-wrap{position:relative}
  .search-icon{width:21px;height:21px;position:absolute;left:16px;top:15px;color:#9dadab}
  input[type=search]{width:100%;background:#0f1b1f;color:#eff7f0;border:1px solid #546766;padding:15px 12px 15px 48px;border-radius:8px;min-height:51px;outline-offset:3px}
  input::placeholder{color:#839791}
  .search-meta{display:flex;align-items:center;gap:10px;padding:16px 0 12px}
  .search-meta label{font-size:.72rem;color:#a9bbb3}
  select{background:#28363a;border:1px solid #526360;border-radius:6px;color:#f0f8f0;padding:7px 9px;max-width:190px;font-size:.75rem}
  .demo-tag{margin-left:auto;font-size:.62rem;letter-spacing:.08em;color:#9bac9e}
  .result-row{display:flex;align-items:center;gap:14px;border-top:1px solid #304145;padding:16px 0}
  .avatar{display:grid;place-items:center;background:#304642;color:#d3f17b;border:1px solid #4a675c;border-radius:10px;width:43px;height:43px;flex:none;font-size:.8rem;font-weight:700}
  .athlete-info{display:flex;flex-direction:column;min-width:0;gap:2px}
  .athlete-info strong,.squad-athlete strong{font-size:.91rem}
  .athlete-info .affiliation,.squad-athlete span{font-size:.75rem;color:#bccbc2}
  .athlete-info small{font-size:.65rem;color:#80958f}
  .track-btn{margin-left:auto;flex:none;border:1px solid #78945f;background:#d3f17b;color:#101b1e;border-radius:7px;padding:9px 11px;font-size:.74rem;font-weight:780}
  .track-btn.tracked{background:transparent;color:#d3f17b}
  .panel-footnote{border-top:1px solid #304145;padding-top:18px;margin-top:4px;font-size:.73rem;color:#8ca09a;line-height:1.65}
  .squad-head{display:flex;align-items:start;justify-content:space-between;gap:8px;border-bottom:1px solid #304145;padding-bottom:22px}
  .squad-head h3{font-size:1.17rem;letter-spacing:-.02em;margin-top:11px}
  .count{font-size:.73rem;background:#354a47;color:#d3f17b;padding:3px 8px;border-radius:40px;vertical-align:3px;margin-left:4px}
  .text-btn{background:none;border:0;color:#d3f17b;font-size:.72rem;padding:7px 0}
  .empty-squad{min-height:207px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:21px 10px}
  .empty-graphic{border:1px dashed #486058;width:45px;height:45px;display:grid;place-items:center;border-radius:50%;color:#d3f17b;font-size:1.4rem;margin-bottom:17px}
  .empty-squad strong{font-size:.9rem}
  .empty-squad p{font-size:.74rem;color:#95a79e;max-width:225px;margin-top:7px}
  .squad-athlete{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-bottom:1px solid #2e4144}
  .squad-athlete-info{display:flex;flex-direction:column;gap:1px}
  .remove-btn{border:1px solid #4f6662;color:#c5d2c7;border-radius:6px;background:transparent;width:30px;height:30px;font-size:1.2rem;line-height:1}
  .squad-cta{display:flex;gap:12px;background:#253731;padding:16px;border:1px solid #426044;border-radius:10px;margin-top:20px}
