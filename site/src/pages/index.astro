---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedBuilds } from '../lib/builds';
import { getServices } from '../lib/services';
import { FOUNDER } from '../lib/site';
import BuildRow from '../components/BuildRow.astro';

// The studio homepage (CONTEXT §6): leads with what Jigg.AI does, offers two paths,
// and uses the build journal as evidence. No featured-build hero and no newsletter
// form up here — buyers should meet engineering evidence first, and Subscribe lives
// on Builds and in the footer (CONTEXT §7).
const [builds, services] = await Promise.all([getPublishedBuilds(), getServices()]);
const recent = builds.slice(0, 4);
---

<BaseLayout title="Jigg.AI">
  <section class="hero container">
    <p class="eyebrow">AI-Accelerated Software Engineering</p>
    {/* nowrap keeps the compound word whole: at narrow widths the hyphen was the
        line break, leaving "AI-" stranded at the end of a line. */}
    <h1 class="display">
      Experienced engineering judgment. <span class="nowrap">AI-accelerated</span> execution.
    </h1>
    <p class="lead">
      From rapid prototypes to modernizing existing systems, Jigg.AI combines
      AI-enabled development with human architecture, review and accountability.
    </p>
    <div class="paths">
      <a class="btn btn--primary" href="/contact">Discuss a project</a>
      <a class="btn" href="/builds">Explore the builds</a>
    </div>
    <p class="cred mono">
      {FOUNDER.short} <a href="/about#founder">About the founder →</a>
    </p>
  </section>

  <section class="services container" aria-labelledby="services-title">
    <div class="sec-head">
      <h2 id="services-title">What Jigg.AI does</h2>
      <a class="view-all mono" href="/services">All services →</a>
    </div>
    <ul class="rows">
      {
        services.map(({ id, service }) => (
          <li class="svc">
            <a class="svc-title" href={`/services#${id}`}>{service.data.title}</a>
            <p class="svc-summary">{service.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    recent.length > 0 && (
      <section class="journal container" aria-labelledby="journal-title">
        <div class="sec-head">
          <h2 id="journal-title">The build journal</h2>
          <a class="view-all mono" href="/builds">All builds →</a>
        </div>
        <p class="section-lead">
          Every build is documented in public: what was built, how it was tested, what it
          cost, and what went wrong. It's how Jigg.AI shows its work before you get in touch.
        </p>
        <ul class="rows">
          {recent.map((b) => <BuildRow build={b} variant="recent" />)}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: 2.75rem; }
  .eyebrow {
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .display {
    font-size: var(--step-display);
    font-weight: 460;
    max-width: 17ch;
    margin-top: 0.9rem;
  }
  .nowrap { white-space: nowrap; }
  .lead {
    color: var(--ink-muted);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.5;
    max-width: 36rem;
    margin-top: 1.25rem;
  }
  .paths { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .cred { margin-top: 1.5rem; }
  .cred a { color: var(--ink); text-decoration-color: var(--brand); white-space: nowrap; }

  .services, .journal { padding-top: 2.5rem; }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.4rem;
  }
  .view-all { text-decoration: none; color: var(--ink-muted); }
  .view-all:hover { color: var(--ink); }
  .journal .section-lead { margin-bottom: 0.9rem; }
  .rows { list-style: none; padding: 0; margin: 0; }
  .rows :global(.row:last-child) { border-bottom: 1px solid var(--border); }
  .svc { border-top: 1px solid var(--border); padding-block: 1.1rem; }
  .svc:last-child { border-bottom: 1px solid var(--border); }
  .svc-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--ink);
    text-decoration: none;
  }
  .svc-title:hover { text-decoration: underline; text-decoration-color: var(--brand); }
  .svc-summary { color: var(--ink-muted); max-width: 44rem; margin-top: 0.3rem; }
</style>
