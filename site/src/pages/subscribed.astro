---
import BaseLayout from '../layouts/BaseLayout.astro';

// Landing page for Buttondown's "After confirming" redirect — shown once a
// subscriber clicks the double opt-in link in their email. Kept out of search
// and the sitemap (noindex + the filter in astro.config.mjs): it's a
// transactional confirmation, not a page anyone should discover cold.
---

<BaseLayout
  title="You're subscribed"
  description="Your subscription to the Jigg.AI build log is confirmed."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <section class="container container--prose confirmed">
    <p class="eyebrow">Subscription confirmed</p>
    <h1>You're in.</h1>
    <p class="lead">
      That's it — you're on the list. From here you'll get one honest build per
      issue: the prompts, the real costs, the test results, and the reproducible
      files. One email per new build, nothing else.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="/builds">Read the build logs</a>
      <a class="btn" href="/">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .confirmed { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.75rem;
  }
  .confirmed h1 { font-size: var(--step-h1); font-weight: 460; max-width: 16ch; }
  .lead {
    color: var(--ink-muted);
    font-size: 1.2rem;
    line-height: 1.5;
    margin-top: 1rem;
    max-width: 36rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
