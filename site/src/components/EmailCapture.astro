---
// Newsletter signup. Posts to our own same-origin Netlify Function
// (/.netlify/functions/subscribe), which calls Buttondown's authenticated API
// server-side. This replaced an earlier browser-direct approach that couldn't
// work reliably: a cross-origin fetch is CORS-blocked, a cross-site hidden-iframe
// submit is stripped by browser tracking protection, and the anonymous embed
// endpoint rate-limits. The function path gives real success/error feedback.
//
// Progressive enhancement: the <form> posts to the function natively, so with JS
// off it still works — the function 303-redirects to /subscribed. With JS, we
// intercept, POST via fetch, and show the result inline without leaving the page.
const ACTION = '/.netlify/functions/subscribe';

interface Props {
  cta?: string;
  note?: string;
  placeholder?: string;
  variant?: 'default' | 'onBrand';
}
const {
  cta = 'Get the builds',
  note = 'One honest build in your inbox — prompts, costs, and files included. One email per new build, no filler.',
  placeholder = 'you@email.com',
  variant = 'default',
} = Astro.props;
---

<div class="capture-shell">
  <form class:list={['capture', variant]} action={ACTION} method="post">
    <input
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      aria-label="Email address"
      placeholder={placeholder}
      required
    />
    <button type="submit" class="btn btn--primary">{cta}</button>
    <p class="note">{note}</p>
    <p class="capture__error" role="alert" hidden></p>
  </form>
  <p class="capture__success" role="status" tabindex="-1" hidden></p>
</div>

<script>
  // Progressive enhancement: intercept the native post, call the function via
  // fetch, and render real success / already-subscribed / error states inline.
  const SUBSCRIBED =
    'Almost there — check your inbox and click the confirmation link to finish subscribing. One email per new build, nothing else.';
  const ALREADY =
    "You're already on the list. If you never confirmed, check your inbox for the confirmation link.";
  const ERRORS: Record<string, string> = {
    invalid_email: 'That doesn’t look like a valid email address.',
    server_not_configured: 'Signups are temporarily unavailable — please try again later.',
    default: 'Something went wrong. Please try again in a moment.',
  };

  document.querySelectorAll<HTMLFormElement>('form.capture').forEach((form) => {
    const shell = form.closest('.capture-shell')!;
    const success = shell.querySelector<HTMLElement>('.capture__success')!;
    const errorEl = form.querySelector<HTMLElement>('.capture__error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const label = button.textContent;

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      button.textContent = busy ? 'Subscribing…' : label;
    };
    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return; // native email/required validation
      errorEl.hidden = true;
      setBusy(true);

      let data: { ok?: boolean; status?: string; error?: string } = {};
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: input.value.trim() }),
        });
        data = await res.json().catch(() => ({}));
      } catch {
        showError(ERRORS.default);
        setBusy(false);
        return;
      }

      if (data.ok) {
        form.hidden = true;
        success.textContent = data.status === 'already' ? ALREADY : SUBSCRIBED;
        success.hidden = false;
        success.focus(); // move screen-reader/keyboard focus to the confirmation
      } else {
        showError(ERRORS[data.error ?? 'default'] ?? ERRORS.default);
        setBusy(false);
      }
    });
  });
</script>

<style>
  .capture {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem;
    align-items: start;
  }
  /* The author `display: grid` above outweighs the UA `[hidden]` rule, so the
     form wouldn't hide on success without this. */
  .capture[hidden] { display: none; }
  .capture input[type='email'] {
    font: inherit;
    padding: 0.75em 0.9em;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    width: 100%;
    min-width: 0;
  }
  .capture input[type='email']:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
  .capture .btn { white-space: nowrap; }
  .capture .btn:disabled { opacity: 0.65; cursor: default; }
  .note {
    grid-column: 1 / -1;
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .capture__error {
    grid-column: 1 / -1;
    color: var(--fault);
    font-size: 0.9rem;
    margin-top: 0.15rem;
  }
  .onBrand input[type='email'] {
    background: var(--surface);
    border-color: color-mix(in srgb, var(--brand) 30%, var(--border-strong));
  }

  .capture__success {
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 0.85em 1em;
    border: 1px solid color-mix(in srgb, var(--brand) 35%, var(--border-strong));
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--brand) 8%, var(--surface));
  }
  .capture__success:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

  @media (max-width: 30rem) {
    .capture { grid-template-columns: 1fr; }
    .capture .btn { width: 100%; justify-content: center; }
  }
</style>
