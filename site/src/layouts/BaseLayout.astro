---
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotpressWebchat from '../components/BotpressWebchat.astro';
import { ORGANIZATION_ID, FOUNDER } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /**
   * Optional social card for this page: a site-relative path to a real image, with
   * its pixel size and alt text. There is no site-wide default card (the old one was
   * withdrawn in October for overclaiming), so pages without one emit no og:image.
   */
  image?: { src: string; width: number; height: number; alt: string };
}

const {
  title,
  description = 'Jigg.AI is an AI-accelerated software engineering studio: experienced engineering judgment, AI-accelerated execution, and a public build journal that shows how the work is done.',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Jigg.AI';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// og:image must be absolute: scrapers don't resolve relative paths.
const ogImage = image ? new URL(image.src, Astro.site).toString() : undefined;

// Organization structured data on every page. The founder's Person entity lives on
// the founder page and is referenced here by @id, so the two describe one graph.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: siteName,
  url: new URL('/', Astro.site).toString(),
  description:
    'AI-accelerated software engineering studio with a public build journal: rapid prototyping and product delivery, legacy modernization and systems engineering, and AI integration and automation.',
  founder: { '@id': FOUNDER.personId },
  sameAs: ['https://github.com/jigg-ai'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      image && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <BotpressWebchat />
    <!-- Site-wide support widget (build #2). Self-initializes into its own vendor
         iframe; the "Runs on this site" dogfood behind builds/botpress. -->

    <script>
      // Contact attribution (CONTEXT §8). On the FIRST page of a visit, remember the
      // external site that referred it and any utm_* tags, in sessionStorage only —
      // gone when the tab closes, never a cookie, and sent nowhere unless the visitor
      // submits the Contact form (ContactForm reads it). Later pages don't overwrite
      // it, so an internal click to /contact still reports where the visit began.
      try {
        if (!sessionStorage.getItem('jg_attr')) {
          const q = new URLSearchParams(location.search);
          let ref_host = '';
          try {
            const r = new URL(document.referrer);
            if (r.hostname !== location.hostname) ref_host = r.hostname;
          } catch {
            /* no or opaque referrer */
          }
          sessionStorage.setItem(
            'jg_attr',
            JSON.stringify({
              ref_host,
              utm_source: q.get('utm_source') || '',
              utm_medium: q.get('utm_medium') || '',
              utm_campaign: q.get('utm_campaign') || '',
            }),
          );
        }
      } catch {
        /* storage blocked (private mode, policy): attribution is optional */
      }
    </script>


    <style>
      .skip-link {
        position: absolute;
        left: 0.5rem;
        top: -3.5rem;
        background: var(--ink);
        color: var(--ink-inverse);
        padding: 0.6rem 0.9rem;
        border-radius: var(--radius-sm);
        z-index: 20;
        transition: top 0.15s ease;
      }
      .skip-link:focus { top: 0.5rem; }
    </style>
  </body>
</html>
